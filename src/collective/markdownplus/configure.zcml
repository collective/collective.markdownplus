<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.markdownplus"
    >

  <include package=".browser" />

  <gs:registerProfile
      name="default"
      title="collective.markdownplus"
      description="Adds a markdown widget for rich text fields with MIME text/markdown."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".setuphandlers.install_portal_transform"
      />

  <gs:registerProfile
      name="uninstall"
      title="collective.markdownplus (uninstall)"
      description="Uninstalls collective.markdownplus."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      post_handler=".setuphandlers.uninstall_portal_transform"
      />

</configure>
