<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <browser:resourceDirectory
      name="collective.markdownplus"
      directory="resources"
      />

  <adapter
      factory=".widget.MarkdownEditorFieldWidget"
      provides="z3c.form.interfaces.IFieldWidget"
      for="plone.app.textfield.interfaces.IRichText
           collective.markdownplus.interfaces.IMarkdownPlusLayer"
      />

  <browser:viewlet
      name="collective.markdownplus.assets"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      class=".viewlets.MarkdownAssetsViewlet"
      permission="zope2.View"
      layer="collective.markdownplus.interfaces.IMarkdownPlusLayer"
      />

  <browser:page
      name="markdownplus-preview"
      for="*"
      class=".preview.MarkdownPreviewView"
      permission="zope2.View"
      layer="collective.markdownplus.interfaces.IMarkdownPlusLayer"
      />

  <browser:page
      name="markdownplus-controlpanel"
      for="plone.base.interfaces.IPloneSiteRoot"
      class=".controlpanel.MarkdownPlusSettingsControlPanel"
      permission="cmf.ManagePortal"
      layer="collective.markdownplus.interfaces.IMarkdownPlusLayer"
      />

</configure>
